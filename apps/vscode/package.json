{
  "name": "docsearch-vscode",
  "displayName": "DocSearch",
  "description": "Search documentation for popular libraries directly in VS Code",
  "version": "0.0.1",
  "publisher": "Fatpandac",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "algolia",
    "docsearch",
    "documentation",
    "search"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "title": "DocSearch",
      "properties": {
        "docsearch.language": {
          "type": "string",
          "default": "en-US",
          "enum": ["en-US", "zh-CN", "fr-FR", "ko-KR", "it-IT"],
          "description": "Preferred language for documentation. Falls back to the first available tag if the doc doesn't support your choice."
        }
      }
    },
    "commands": [
      {
        "command": "docsearch.antd",
        "title": "Antd",
        "category": "DocSearch"
      },
      {
        "command": "docsearch.antdv",
        "title": "Antdv",
        "category": "DocSearch"
      },
