    "dev": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --target=node18 --watch",
    "generate": "ts-node scripts/generate.ts",
    "package": "npm run build && vsce package",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docsearch/core": "file:../../packages/core"
